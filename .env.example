# BrowserStack Configuration
# Copia este archivo a .env si quieres usar variables de entorno

BROWSERSTACK_USERNAME=tu_username_de_browserstack
BROWSERSTACK_ACCESS_KEY=tu_access_key_de_browserstack

# Geolocalización
BROWSERSTACK_GEO_LOCATION=CO
BROWSERSTACK_TIMEZONE=America/Bogota

# Configuración de build
BROWSERSTACK_BUILD_NAME=browserstack-build-1
BROWSERSTACK_PROJECT_NAME=BrowserStack Sample

# BrowserStack Local
BROWSERSTACK_LOCAL=true
BROWSERSTACK_DEBUG=true

# URL base de la aplicación
WEBDRIVER_BASE_URL=https://webx.muthematrix.com/

